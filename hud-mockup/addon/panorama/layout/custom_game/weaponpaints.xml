                </Button>
              </Panel>
              <Panel class="settingRow" id="row_wear">
                <Label hittest="false" class="settingLabel" text="ИЗНОС" />
                <Panel class="valueControls">
                  <Button class="step" id="wear_minus">
                    <Label hittest="false" class="buttonText" text="−" />
                  </Button>
                  <Button class="valueInput" id="wear">
                    <Label hittest="false" class="buttonText" text="{s:wear}" />
                  </Button>
                  <Button class="step" id="wear_plus">
                    <Label hittest="false" class="buttonText" text="+" />
                  </Button>
                </Panel>
              </Panel>
              <Panel class="presetRow" id="presets">
