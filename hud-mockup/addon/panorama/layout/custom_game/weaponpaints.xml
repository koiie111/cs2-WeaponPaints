            <Panel class="catalogFooter" id="catalog_footer">
              <Label hittest="false" class="muted" text="{s:count}" />
              <Button class="page" id="prev">
                <Label hittest="false" class="buttonText" text="‹" />
              </Button>
              <Label hittest="false" class="pageNumber" text="{s:page}" />
              <Button class="page" id="next">
                <Label hittest="false" class="buttonText" text="›" />
              </Button>
            </Panel>
          </Panel>
          <Panel class="settings pane" id="settings">
            <Panel class="previewColumn">
              <Panel hittest="false" class="previewImage bank cell0" id="preview_art" />
