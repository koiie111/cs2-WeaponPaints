              </Button>
            </Panel>
            <Panel class="hero" id="hero">
              <Panel class="heroArt">
                <Panel hittest="false" class="heroImage finishes cell0" id="hero_art" />
              </Panel>
              <Panel class="heroCopy">
                <Label hittest="false" class="heroTitle" text="{s:hero_title}" />
                <Label hittest="false" class="heroSub" text="{s:hero_subtitle}" />
                <Label hittest="false" class="heroValue" text="{s:hero_wear}" />
                <Label hittest="false" class="heroValue" text="{s:hero_seed}" />
                <Label hittest="false" class="heroValue" text="{s:hero_stattrak}" />
                <Button class="configure" id="configure">
                  <Label hittest="false" class="buttonText" text="НАСТРОИТЬ" />
                </Button>
              </Panel>
            </Panel>
            <Panel class="grid" id="grid">
              <Panel class="cardRow">
                <Button class="item" id="item_0">
                  <Panel hittest="false" class="rarity" />
                  <Label hittest="false" class="selectedMark" text="✓" />
                  <Panel hittest="false" class="itemImage finishes cell0" id="image_0" />
                  <Label hittest="false" class="itemName" text="{s:item_0}" />
                  <Label hittest="false" class="itemSub" text="{s:sub_0}" />
                </Button>
                <Button class="item" id="item_1">
                  <Panel hittest="false" class="rarity" />
                  <Label hittest="false" class="selectedMark" text="✓" />
