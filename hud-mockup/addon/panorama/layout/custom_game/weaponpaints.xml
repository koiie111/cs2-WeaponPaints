<root>
  <styles>
    <include src="s2r://panorama/styles/custom_game/weaponpaints.vcss_c" />
  </styles>
  <Panel hittest="false" class="outer">
    <Panel class="app" id="wp_root">
      <Panel class="shell">
        <Panel class="side">
          <Label hittest="false" class="brand" text="4ILL / SKINS" />
          <Button class="nav" id="nav_weapons">
            <Label hittest="false" class="buttonText" text="⌁   ОРУЖИЕ" />
          </Button>
          <Button class="nav" id="nav_knives">
            <Label hittest="false" class="buttonText" text="◇   НОЖИ" />
          </Button>
          <Button class="nav" id="nav_gloves">
            <Label hittest="false" class="buttonText" text="▧   ПЕРЧАТКИ" />
          </Button>
          <Button class="nav" id="nav_agents">
            <Label hittest="false" class="buttonText" text="◉   АГЕНТЫ" />
          </Button>
          <Button class="nav" id="nav_music">
            <Label hittest="false" class="buttonText" text="♫   МУЗЫКА" />
          </Button>
          <Button class="nav" id="nav_pins">
            <Label hittest="false" class="buttonText" text="✦   ЗНАЧКИ" />
          </Button>
          <Button class="nav" id="nav_graffiti">
            <Label hittest="false" class="buttonText" text="▤   ГРАФФИТИ" />
          </Button>
          <Button class="nav" id="nav_pet">
            <Label hittest="false" class="buttonText" text="◈   ПИТОМЕЦ" />
          </Button>
        </Panel>
        <Panel class="main">
          <Panel class="top">
            <Button class="back" id="back">
              <Label hittest="false" class="buttonText" text="‹" />
            </Button>
            <Label hittest="false" class="crumbText" text="{s:breadcrumb}" />
            <Label hittest="false" class="title" text="{s:title}" />
            <Button class="team" id="team">
              <Label hittest="false" class="buttonText" text="{s:team}" />
            </Button>
            <Button class="close" id="close">
              <Label hittest="false" class="buttonText" text="✕" />
            </Button>
          </Panel>
          <Panel class="home pane" id="home">
            <Panel class="mosaicTop">
              <Button class="mosaic large" id="category_rifles">
                <Panel hittest="false" class="categoryStripe" />
                <Panel hittest="false" class="tileImage bank cell0" />
                <Label hittest="false" class="tileTitle" text="ВИНТОВКИ" />
              </Button>
              <Panel class="mosaicStack">
                <Button class="mosaic wide" id="category_pistols">
                  <Panel hittest="false" class="categoryStripe" />
                  <Panel hittest="false" class="tileImage bank cell3" />
                  <Label hittest="false" class="tileTitle" text="ПИСТОЛЕТЫ" />
                </Button>
                <Button class="mosaic wide" id="category_smg">
                  <Panel hittest="false" class="categoryStripe" />
                  <Panel hittest="false" class="tileImage bank cell6" />
                  <Label hittest="false" class="tileTitle" text="ПИСТОЛЕТЫ-ПУЛЕМЁТЫ" />
                </Button>
              </Panel>
            </Panel>
            <Panel class="mosaicBottom">
              <Button class="mosaic small" id="category_shotguns">
                <Panel hittest="false" class="categoryStripe" />
