                  <Panel hittest="false" class="itemImage finishes cell4" id="image_4" />
                  <Label hittest="false" class="itemName" text="{s:item_4}" />
                  <Label hittest="false" class="itemSub" text="{s:sub_4}" />
                </Button>
              </Panel>
              <Panel class="cardRow">
                <Button class="item" id="item_5">
                  <Panel hittest="false" class="rarity" />
                  <Label hittest="false" class="selectedMark" text="✓" />
                  <Panel hittest="false" class="itemImage finishes cell5" id="image_5" />
                  <Label hittest="false" class="itemName" text="{s:item_5}" />
                  <Label hittest="false" class="itemSub" text="{s:sub_5}" />
